{
  "name": "dorisio-sdk",
  "version": "0.1.0",
  "description": "Dorisio SDK - Client abstraction layer for payment integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "create-dorisio-app": "./dist/cli/create-app.js",
    "dorisio": "./dist/cli/create-app.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./sandbox": {
      "import": "./dist/sandbox/sandbox-client.js",
      "types": "./dist/sandbox/sandbox-client.d.ts"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "tsup": "^8.0.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesOptional": {
    "react": true
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
